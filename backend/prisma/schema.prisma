}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Class {
  classId            Int                  @id @default(autoincrement()) @map("class_id")
  schoolYearId       Int                  @map("school_year_id")
  classDateStart     DateTime             @map("class_date_start") @db.Timestamptz(6)
  classDateEnd       DateTime             @map("class_date_end") @db.Timestamptz(6)
  classRecurrence    Boolean?             @default(false) @map("class_recurrence")
  studioModalityId   Int                  @map("studio_modality_id")
  classFinalFee      Decimal              @map("class_final_fee") @db.Decimal(10, 2)
  classStatusId      Int                  @map("class_status_id")
  classStatus        ClassStatus          @relation(fields: [classStatusId], references: [classStatusId], onDelete: Cascade, onUpdate: Cascade)
  schoolYear         SchoolYear           @relation(fields: [schoolYearId], references: [schoolYearId], onDelete: Cascade, onUpdate: Cascade)
  studioModality     StudioModality       @relation(fields: [studioModalityId], references: [studioModalityId], onDelete: Cascade, onUpdate: Cascade)
