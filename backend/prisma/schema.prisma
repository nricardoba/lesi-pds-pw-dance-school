generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Address {
  street_id    Int            @id
  street_name  String         @db.VarChar
  postal_code  String         @db.VarChar
  Postal_Code  Postal_Code    @relation(fields: [postal_code], references: [postal_code], onDelete: NoAction, onUpdate: NoAction)
  User_Address User_Address[]
}

model Category {
  category_id          Int                    @id
  category_name        String                 @unique @db.VarChar
  Item_Characteristics Item_Characteristics[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Class {
  class_id             Int                    @id
  school_year_id       Int
  class_day            DateTime               @db.Date
  class_time_start     DateTime               @db.Time(6)
  class_time_end       DateTime               @db.Time(6)
  class_recurrence     Boolean?
  studio_modality_id   Int
  class_final_fee      Decimal                @db.Decimal(10, 2)
  class_status_id      Int
  Class_Status         Class_Status           @relation(fields: [class_status_id], references: [class_status_id], onDelete: NoAction, onUpdate: NoAction)
  School_Year          School_Year            @relation(fields: [school_year_id], references: [school_year_id], onDelete: NoAction, onUpdate: NoAction)
  Studio_Modality      Studio_Modality        @relation(fields: [studio_modality_id], references: [studio_modality_id], onDelete: NoAction, onUpdate: NoAction)
  Class_Extra_Fee      Class_Extra_Fee[]
  Class_Status_History Class_Status_History[]
  User_Class           User_Class[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Class_Extra_Fee {
  class_extra_fee_id        Int                    @id
  class_extra_fee_value     Decimal                @db.Decimal(10, 2)
  class_extra_fee_reason_id Int
  class_id                  Int
  Class_Extra_Fee_Reason    Class_Extra_Fee_Reason @relation(fields: [class_extra_fee_reason_id], references: [class_extra_fee_reason_id], onDelete: NoAction, onUpdate: NoAction)
  Class                     Class                  @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
}

model Class_Extra_Fee_Reason {
  class_extra_fee_reason_id   Int               @id
  class_extra_fee_reason_desc String            @unique @db.VarChar
  Class_Extra_Fee             Class_Extra_Fee[]
}

model Class_Status {
  class_status_id      Int                    @id
  class_status_desc    String                 @unique @db.VarChar
  Class                Class[]
  Class_Status_History Class_Status_History[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Class_Status_History {
  class_status_history_id   Int          @id
  class_id                  Int
  class_status_id           Int
  user_id                   Int
  class_status_history_date DateTime     @db.Timestamptz(6)
  Class                     Class        @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  Class_Status              Class_Status @relation(fields: [class_status_id], references: [class_status_id], onDelete: NoAction, onUpdate: NoAction)
  User                      User         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model Color {
  color_id             Int                    @id
  color_name           String                 @unique @db.VarChar
  Item_Characteristics Item_Characteristics[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Contact {
  contact_id      Int            @id
  contact_value   String         @db.VarChar
  contact_type_id Int
  Contact_Type    Contact_Type   @relation(fields: [contact_type_id], references: [contact_type_id], onDelete: NoAction, onUpdate: NoAction)
  User_Contact    User_Contact[]
}

model Contact_Type {
  contact_type_id   Int       @id
  contact_type_desc String    @unique @db.VarChar
  Contact           Contact[]
}

model Dance_Type {
  dance_type_id                   Int                               @id
  dance_type_name                 String                            @unique @db.VarChar
  Item_Characteristics_Dance_Type Item_Characteristics_Dance_Type[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Item {
  item_id                 Int                  @id
  item_characteristics_id Int
  item_condition_id       Int
  Item_Characteristics    Item_Characteristics @relation(fields: [item_characteristics_id], references: [item_characteristics_id], onDelete: NoAction, onUpdate: NoAction)
  Item_Condition          Item_Condition       @relation(fields: [item_condition_id], references: [item_condition_id], onDelete: NoAction, onUpdate: NoAction)
  School_Item             School_Item?
  User_Item               User_Item?
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Item_Characteristics {
  item_characteristics_id         Int                               @id
  item_characteristics_name       String                            @db.VarChar
  color_id                        Int
  size_id                         Int?
  category_id                     Int
  Item                            Item[]
  Category                        Category                          @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  Color                           Color                             @relation(fields: [color_id], references: [color_id], onDelete: NoAction, onUpdate: NoAction)
  Size                            Size?                             @relation(fields: [size_id], references: [size_id], onDelete: NoAction, onUpdate: NoAction)
  Item_Characteristics_Dance_Type Item_Characteristics_Dance_Type[]
  Item_Image                      Item_Image[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Item_Characteristics_Dance_Type {
  item_characteristics_id Int
  dance_type_id           Int
  Dance_Type              Dance_Type           @relation(fields: [dance_type_id], references: [dance_type_id], onDelete: NoAction, onUpdate: NoAction)
  Item_Characteristics    Item_Characteristics @relation(fields: [item_characteristics_id], references: [item_characteristics_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([item_characteristics_id, dance_type_id])
}

model Item_Condition {
  item_condition_id   Int    @id
  item_condition_name String @unique @db.VarChar
  Item                Item[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Item_Image {
  item_image_id           Int                  @id
  item_characteristics_id Int
  item_image_url          String               @db.VarChar
  item_image_is_main      Boolean
  Item_Characteristics    Item_Characteristics @relation(fields: [item_characteristics_id], references: [item_characteristics_id], onDelete: NoAction, onUpdate: NoAction)
}

model Locality {
  locality_id   Int           @id
  locality_name String        @db.VarChar
  Postal_Code   Postal_Code[]
}

model Modality {
  modality_id         Int               @id
  modality_name       String            @unique @db.VarChar
  modality_hourly_fee Decimal           @db.Decimal(10, 2)
  Studio_Modality     Studio_Modality[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Postal_Code {
  postal_code String    @id @db.VarChar
  locality_id Int
  Address     Address[]
  Locality    Locality  @relation(fields: [locality_id], references: [locality_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Rent_Item {
  rent_id              Int         @id
  item_id              Int
  user_id              Int
  rent_date_start      DateTime    @db.Timestamptz(6)
  rent_date_end        DateTime    @db.Timestamptz(6)
  actual_rent_date_end DateTime?   @db.Timestamptz(6)
  item_damaged         Boolean?
  School_Item          School_Item @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
  User                 User        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Schedule_Vacancy {
  schedule_vacancy_id         Int         @id
  user_id                     Int
  school_year_id              Int
  schedule_vacancy_day        DateTime    @db.Date
  schedule_vacancy_start      DateTime    @db.Time(6)
  schedule_vacancy_end        DateTime    @db.Time(6)
  schedule_vacancy_recurrence Boolean?
  School_Year                 School_Year @relation(fields: [school_year_id], references: [school_year_id], onDelete: NoAction, onUpdate: NoAction)
  User                        User        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model School_Item {
  item_id   Int         @id
  rent_fee  Decimal     @db.Decimal(10, 2)
  Rent_Item Rent_Item[]
  Item      Item        @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
}

model School_Year {
  school_year_id    Int                @id
  school_year_name  String             @unique @db.VarChar
  school_year_start DateTime           @db.Date
  school_year_end   DateTime           @db.Date
  Class             Class[]
  Schedule_Vacancy  Schedule_Vacancy[]
}

model Size {
  size_id              Int                    @id
  size_name            String                 @unique @db.VarChar
  Item_Characteristics Item_Characteristics[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Student_Number {
  user_id        Int    @id
  student_number String @unique @db.VarChar
  User           User   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model Studio {
  studio_id           Int               @id
  studio_name         String            @unique @db.VarChar
  studio_max_capacity Int
  Studio_Modality     Studio_Modality[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Studio_Modality {
  studio_modality_id Int      @id
  studio_id          Int
  modality_id        Int
  Class              Class[]
  Modality           Modality @relation(fields: [modality_id], references: [modality_id], onDelete: NoAction, onUpdate: NoAction)
  Studio             Studio   @relation(fields: [studio_id], references: [studio_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([studio_id, modality_id], map: "Studio_Modality_studio_id_modality_id_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User {
  user_id              Int                    @id
  user_name            String                 @db.VarChar
  user_birth_date      DateTime?              @db.Date
  user_start_date      DateTime?              @db.Date
  user_type_id         Int
  user_is_active       Boolean
  Class_Status_History Class_Status_History[]
  Rent_Item            Rent_Item[]
  Schedule_Vacancy     Schedule_Vacancy[]
  Student_Number       Student_Number?
  User_Type            User_Type              @relation(fields: [user_type_id], references: [user_type_id], onDelete: NoAction, onUpdate: NoAction)
  User_Address         User_Address[]
  User_Class           User_Class[]
  User_Contact         User_Contact[]
  User_Credential      User_Credential?
  User_Item            User_Item[]
  User_NIF             User_NIF?
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_Address {
  user_address_id Int     @id
  user_id         Int
  street_id       Int
  is_main_address Boolean
  Address         Address @relation(fields: [street_id], references: [street_id], onDelete: NoAction, onUpdate: NoAction)
  User            User    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, street_id], map: "User_Address_user_id_street_id_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_Class {
  class_id           Int
  user_id            Int
  user_class_role_id Int?
  user_validation    Boolean
  Class              Class            @relation(fields: [class_id], references: [class_id], onDelete: NoAction, onUpdate: NoAction)
  User_Class_Role    User_Class_Role? @relation(fields: [user_class_role_id], references: [user_class_role_id], onDelete: NoAction, onUpdate: NoAction)
  User               User             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@id([class_id, user_id])
}

model User_Class_Role {
  user_class_role_id   Int          @id
  user_class_role_desc String       @unique @db.VarChar
  User_Class           User_Class[]
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_Contact {
  user_contact_id Int              @id
  user_id         Int
  contact_id      Int
  is_main_contact Boolean
  Contact         Contact          @relation(fields: [contact_id], references: [contact_id], onDelete: NoAction, onUpdate: NoAction)
  User            User             @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  User_Credential User_Credential?

  @@unique([user_id, contact_id], map: "User_Contact_user_id_contact_id_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_Credential {
  user_id                       Int          @id
  user_contact_id               Int          @unique
  user_credential_password_hash String       @db.VarChar
  user_credential_last_login    DateTime?    @db.Timestamptz(6)
  User_Contact                  User_Contact @relation(fields: [user_contact_id], references: [user_contact_id], onDelete: NoAction, onUpdate: NoAction)
  User                          User         @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_Item {
  item_id Int  @id
  user_id Int
  Item    Item @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
  User    User @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model User_NIF {
  user_id  Int    @id
  user_nif String @unique @db.VarChar
  User     User   @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model User_Type {
  user_type_id   Int    @id
  user_type_desc String @unique @db.VarChar
  User           User[]
}
