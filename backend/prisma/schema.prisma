generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model Address {
  streetId      Int           @id @default(autoincrement()) @map("street_id")
  streetName    String        @map("street_name") @db.VarChar
  postalCode    String        @map("postal_code") @db.VarChar
  postalCodeRel PostalCode    @relation(fields: [postalCode], references: [postalCode], onDelete: Cascade, onUpdate: Cascade)
  userAddress   UserAddress[]
}

model Category {
  categoryId          Int                   @id @default(autoincrement()) @map("category_id")
  categoryName        String                @unique @map("category_name") @db.VarChar
